# React Native's Metro bundler and the iOS/Android native builds resolve modules by
# walking node_modules, which pnpm's default symlinked layout breaks. Hoisting is the
# only layout React Native supports.
node-linker=hoisted

# Several native libraries declare peer dependencies they do not ship (Viro names
# @reactvision/viro-web-renderer, which is not published on npm). An unmet peer must
# warn, not fail the install.
strict-peer-dependencies=false
auto-install-peers=true
