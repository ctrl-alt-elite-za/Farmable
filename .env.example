# Copy to .env and fill in real values. Never commit .env itself.

# --- backend (#3) ---
# Set your own password. For URLs, percent-encode special characters.
POSTGRES_USER=farmable
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=farmable
# Compose uses database:5432; host access requires a forwarded port and localhost instead.
DATABASE_URL=postgresql+psycopg://farmable:replace-with-a-local-password@database:5432/farmable
LOG_LEVEL=info
COMMIT_SHA=unknown
API_PORT=8000

# --- mobile app (#4) ---
EXPO_PUBLIC_API_URL=http://localhost:8000
