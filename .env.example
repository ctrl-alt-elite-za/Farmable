# Copy to .env and fill in real values. Never commit .env itself.

# --- backend (#3) ---
# Set your own password. For URLs, percent-encode special characters.
POSTGRES_USER=farmable
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=farmable
# Compose uses database:5432; host access requires a forwarded port and localhost instead.
DATABASE_URL=postgresql+psycopg://farmable:replace-with-a-local-password@database:5432/farmable
LOG_LEVEL=info
COMMIT_SHA=unknown
# Required stable secret used to sign one-time export download links. Replace this
# empty value before starting any backend environment; the service refuses to boot
# without it. Keep it unchanged while links may still be valid.
EXPORT_TOKEN_SECRET=
API_PORT=8000

# --- mobile app (#4) ---
# The app's only setting. Never put a secret in an EXPO_PUBLIC_* variable: they are
# inlined into the JavaScript bundle and readable by anyone holding the app.
EXPO_PUBLIC_API_URL=http://localhost:8000
# 1 replaces live camera input with recorded frames (emulators, CI). Never 1 in a
# build that also sets EXPO_PUBLIC_DEMO_MODE=1 - scripts/check-test-mode.sh fails it.
EXPO_PUBLIC_TEST_MODE=0
EXPO_PUBLIC_DEMO_MODE=0
# Stamped by CI so a self-test report can be traced back to the build that ran it.
EXPO_PUBLIC_BUILD_SHA=unknown

# --- outside services (#7) ---
# Safe default: no external requests. Fake mode requires ci or staging.
ENVIRONMENT=development
INTEGRATIONS_MODE=disabled
# Load real values from SSM or your git-ignored .env, never commit them here.
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FRAUD_GUARD_CONFIRMED=false
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=
TURNSTILE_SITE_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_RESOURCE=
AZURE_SPEECH_REGION=
GEMINI_API_KEY=
GEMINI_MODEL=
# Separately opt in to authenticated Live credential issuance (#7).
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=
# Sample mode is explicit and API responses retain the synthetic-data warning.
FORECAST_DATA_MODE=disabled
# Import job only: do not inject an issue-writing token into the API or mobile app.
FORECAST_GITHUB_ENABLED=false
FORECAST_GITHUB_REPOSITORY=ctrl-alt-elite-za/Farmable
FORECAST_GITHUB_TOKEN=
CROP_HEALTH_API_KEY=
# Explicit, consented focus-photo diagnoses only; also requires private photo storage.
DIAGNOSIS_ENABLED=false
MAPS_SERVER_API_KEY=
# Infobip SMS (issue #9 live OTP delivery).
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SMS_SENDER=
# Standalone WhatsApp template-message capability (not wired into any flow yet).
# Infobip's shared sandbox sender (447860088970) works for testing; it cannot
# carry Almanac branding. Real branding needs a dedicated, Meta-verified WABA.
INFOBIP_WHATSAPP_SENDER=
# Gmail SMTP (issue #9 live email OTP/notification delivery). SMTP_PASSWORD is a
# 16-character Gmail App Password, never the account password - see README.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Almanac
EMAIL_FROM_ADDRESS=
# All FAULT_<SERVICE> switches default to false; rejected outside ci/staging.
# Smoke inputs only (fresh Turnstile widget token; verified team phone):
SMOKE_TURNSTILE_TOKEN=
SMOKE_PHONE=
