# Copy to .env and fill in real values. Never commit .env itself.

# --- backend (#3) ---
DATABASE_URL=postgresql+psycopg://farmable:farmable@localhost:5432/farmable
LOG_LEVEL=info

# --- mobile app (#4) ---
# The app's only setting. Never put a secret in an EXPO_PUBLIC_* variable: they are
# inlined into the JavaScript bundle and readable by anyone holding the app.
EXPO_PUBLIC_API_URL=http://localhost:8000
# 1 replaces live camera input with recorded frames (emulators, CI). Never 1 in a
# build that also sets EXPO_PUBLIC_DEMO_MODE=1 - scripts/check-test-mode.sh fails it.
EXPO_PUBLIC_TEST_MODE=0
EXPO_PUBLIC_DEMO_MODE=0
# Stamped by CI so a self-test report can be traced back to the build that ran it.
EXPO_PUBLIC_BUILD_SHA=unknown
