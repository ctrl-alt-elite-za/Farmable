<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later (android:dataExtractionRules). Same rule as
  backup_rules.xml, for cloud backup and for device-to-device transfer: the
  session is tied to this phone's Keystore and must not travel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
