# Secrets and credentials
.env*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
*serviceAccount*.json

# Datasets (raw data is fetched/documented, not committed)
apps/ml-service/data/raw/
*.csv.gz
*.parquet

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.uv-cache/

# Node / JS / TS
node_modules/
.pnpm-store/
dist/
build/
.expo/
apps/mobile/android/
apps/mobile/ios/
*.ipa
*.apk
.next/
coverage/

# ML artifacts (model weights/checkpoints, notebooks, MLflow — see #20)
apps/ml-service/vision/data/*
!apps/ml-service/vision/data/.gitkeep
apps/ml-service/vision/models/*
!apps/ml-service/vision/models/.gitkeep
# Training runs hold batch mosaics of private field photos; only report JSON is committed.
apps/ml-service/vision/runs/
apps/ml-service/vision/reports/*
!apps/ml-service/vision/reports/.gitkeep
!apps/ml-service/vision/reports/README.md
!apps/ml-service/vision/reports/*.json
*.ckpt
*.pt
*.pth
*.h5
*.onnx
checkpoints/
.ipynb_checkpoints/
mlruns/

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
# Disposable CI output, generated SQL and scanner data must never be committed.
.ci-reports/
.ci-tmp/
