# Secrets and credentials
.env*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
*serviceAccount*.json

# Datasets (raw data is fetched/documented, not committed)
apps/ml-service/data/raw/
*.csv.gz
*.parquet

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.uv-cache/

# Node / JS / TS
node_modules/
.pnpm-store/
dist/
build/
*.ipa
*.apk

# The Flutter app's android/ and ios/ are committed source, not generated
# output as they were under Expo's `expo prebuild`. Ignoring them silently
# dropped a new Android resource and broke the release build; apps/mobile's
# own .gitignore (and android/.gitignore, ios/.gitignore) cover the real
# build artifacts.
.next/
coverage/

# ML artifacts (model weights/checkpoints, notebooks, MLflow — see #20)
apps/ml-service/vision/data/*
!apps/ml-service/vision/data/.gitkeep
apps/ml-service/vision/models/*
!apps/ml-service/vision/models/.gitkeep
# Training runs hold batch mosaics of private field photos; only report JSON is committed.
apps/ml-service/vision/runs/
apps/ml-service/vision/reports/*
!apps/ml-service/vision/reports/.gitkeep
!apps/ml-service/vision/reports/README.md
!apps/ml-service/vision/reports/*.json
*.ckpt
*.pt
*.pth
*.h5
*.onnx
checkpoints/
.ipynb_checkpoints/
mlruns/
# Ultralytics downloads this prompt encoder beside the checkpoint during
# YOLOE prompt baking; it is a disposable cache, never a mobile artifact.
/mobileclip2_b.ts

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.log
# Disposable CI output, generated SQL and scanner data must never be committed.
.ci-reports/
.ci-mobile-debug/
.ci-tmp/

# Private local prototype state (never the production database).
.farmable-demo/
