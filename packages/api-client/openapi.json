{
  "components": {
    "schemas": {
      "AuthProgressResponse": {
        "additionalProperties": false,
        "properties": {
          "next_step": {
            "enum": ["phone", "email"],
            "title": "Next Step",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": ["user_id", "next_step"],
        "title": "AuthProgressResponse",
        "type": "object"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "Error",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": ["error"],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LiveResponse": {
        "additionalProperties": false,
        "properties": {
          "sha": {
            "title": "Sha",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["sha"],
        "title": "LiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Identifier",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["identifier", "password"],
        "title": "LoginRequest",
        "type": "object"
      },
      "ReadyResponse": {
        "additionalProperties": false,
        "properties": {
          "database": {
            "enum": ["ok", "down"],
            "title": "Database",
            "type": "string"
          },
          "sha": {
            "title": "Sha",
            "type": "string"
          },
          "worker": {
            "enum": ["ok", "down"],
            "title": "Worker",
            "type": "string"
          }
        },
        "required": ["database", "worker", "sha"],
        "title": "ReadyResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 20,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": ["refresh_token"],
        "title": "RefreshRequest",
        "type": "object"
      },
      "ResendOtpRequest": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "enum": ["phone", "email"],
            "title": "Channel",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": ["user_id", "channel"],
        "title": "ResendOtpRequest",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": ["access_token", "refresh_token", "expires_at", "user"],
        "title": "SessionResponse",
        "type": "object"
      },
      "SignUpRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "First Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 15,
            "pattern": ".*\\S.*",
            "title": "Password",
            "type": "string"
          },
          "phone": {
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone",
            "type": "string"
          },
          "surname": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Surname",
            "type": "string"
          }
        },
        "required": ["first_name", "surname", "phone", "email", "password"],
        "title": "SignUpRequest",
        "type": "object"
      },
      "UserResponse": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "first_name": {
            "title": "First Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "phone": {
            "title": "Phone",
            "type": "string"
          },
          "phone_verified": {
            "title": "Phone Verified",
            "type": "boolean"
          },
          "surname": {
            "title": "Surname",
            "type": "string"
          }
        },
        "required": [
          "id",
          "first_name",
          "surname",
          "phone",
          "email",
          "phone_verified",
          "email_verified"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "VerifyOtpRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": ["user_id", "code"],
        "title": "VerifyOtpRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Farmable API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "authLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Login"
      }
    },
